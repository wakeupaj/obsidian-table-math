{
	"name": "obsidian-table-math",
	"version": "1.0.0",
	"description": "Add spreadsheet-like math calculations to markdown tables with automatic totals and live updates",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "plugin", "table", "math", "calculations", "spreadsheet", "markdown"],
	"repository": {
		"type": "git",
		"url": "https://github.com/wakeupaj/obsidian-table-math.git"
	},
	"homepage": "https://github.com/wakeupaj/obsidian-table-math",
	"author": "aj",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
